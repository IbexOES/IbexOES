        </section>

        <!-- Skills Section -->
        <section>
            <h2><i class="fas fa-tools"></i> Skills & Expertise</h2>
            <div class="skills-grid">
                <div class="skill-category">
                    <h4><i class="fas fa-bullhorn text-accent"></i> Marketing & Strategy</h4>
                    <div class="skill-tags">
                        <span class="tag">SEO Optimization</span>
                        <span class="tag">Email Campaigns</span>
