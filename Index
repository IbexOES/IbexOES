                        <span class="tag">Audience Targeting</span>
                        <span class="tag">Metrics & Analytics</span>
                    </div>
                </div>

                <div class="skill-category">
                    <h4><i class="fas fa-paint-brush text-accent"></i> Design & Tools</h4>
                    <div class="skill-tags">
                        <span class="tag">Canva</span>
                        <span class="tag">Figma</span>
                        <span class="tag">MS Word</span>
                        <span class="tag">MS Excel</span>
                        <span class="tag">MS PowerPoint</span>
                    </div>
                </div>

                <div class="skill-category">
                    <h4><i class="fas fa-graduation-cap text-accent"></i> Core & Education</h4>
                    <div class="skill-tags">
                        <span class="tag">Electronic Engineering</span>
                        <span class="tag">Client Communications</span>
                        <span class="tag">Content Writing</span>
                        <span class="tag">Mathematics</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer>
            <p>&copy; 2026 Aqeel Haider. Built with HTML & CSS for GitHub Pages.</p>
        </footer>
    </div>

</body>
</html>
